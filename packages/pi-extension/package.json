{
  "name": "@parallel-web/pi-extension",
  "version": "0.0.1",
  "description": "Add web search and web fetch to your pi agent",
  "author": "Parallel Web",
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "parallel-web-cli": "0.2.0",
    "typebox": "^1.1.37"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "^0.72.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "pi.dev",
    "pi agent",
    "extension",
    "parallel",
    "web",
    "search",
    "fetch",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parallel-web/parallel-npm-packages.git",
    "directory": "packages/pi-extension"
  },
  "publishConfig": {
    "access": "public"
  }
}
