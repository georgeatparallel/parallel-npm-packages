{
  "name": "@parallel-web/opencode-plugin",
  "version": "1.0.2",
  "description": "OpenCode plugin that replaces webfetch and websearch with Parallel CLI",
  "author": "Parallel Web",
  "license": "MIT",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "opencode",
    "plugin",
    "parallel",
    "web",
    "search",
    "fetch",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parallel-web/parallel-npm-packages.git",
    "directory": "packages/opencode-plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "parallel-web-cli": "0.2.0",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.3.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.3.0",
    "@opencode-ai/sdk": "^1.3.0",
    "@types/node": "^20.0.0"
  }
}
